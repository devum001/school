# demo preserves the independent localStorage workspace; live requires the backend.
VITE_APP_MODE=demo
# Public URL only, including the backend route prefix. Never put secrets in VITE_*.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional map tile provider overrides (public URLs/attribution only).
# Defaults to OpenStreetMap public tiles; configure a suitable provider for production traffic.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
